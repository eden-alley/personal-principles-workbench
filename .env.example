# LibreChat: codex uses existing SDK login; api uses an OpenAI-compatible service.
# Switching to api affects BOTH chat and automatic source organization (provider billing).
LIBRARY_PROVIDER=codex
LIBRARY_API_BASE_URL=
LIBRARY_API_KEY=
LIBRARY_API_MODEL=
LIBRARY_API_TIMEOUT=120

# Legacy Django app configuration (independent from LibreChat):
# Copy to .env when you want environment overrides. The application default is Codex;
# set AI_PROVIDER=api for the ordinary API or AI_PROVIDER=demo for offline examples.
# Never commit .env. Codex login is managed by the official SDK.
# AI_PROVIDER=codex
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=30
# CODEX_MODEL=gpt-6.1-sol
# CODEX_REASONING_EFFORT=high
CODEX_TIMEOUT=120
