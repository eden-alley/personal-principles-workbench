diff --git a/client/src/components/Library/Collect.tsx b/client/src/components/Library/Collect.tsx
new file mode 100644
index 0000000..4d0a770
--- /dev/null
+++ b/client/src/components/Library/Collect.tsx
@@ -0,0 +1,56 @@
+import { useState } from 'react';
+import { Button } from '@librechat/client';
+import { libraryService } from 'librechat-data-provider';
+import { useOperationKey, useLibraryWrite } from './hooks';
+import { useLocalize } from '~/hooks';
+import { Failure } from './Feedback';
+import LibraryDialog from './Dialog';
+
+export default function Collect({
+  conversationId,
+  messageId,
+}: {
+  conversationId: string;
+  messageId: string;
+}) {
+  const localize = useLocalize();
+  const operationKey = useOperationKey();
+  const [open, setOpen] = useState(false);
+  const collect = useLibraryWrite('collect', libraryService.collect);
+  return (
+    <div className="mt-2 text-sm">
+      {collect.isSuccess ? (
+        <div className="flex flex-wrap items-center gap-2">
+          <span role="status" className="text-text-secondary">
+            {localize('com_ui_library_collected')}
+          </span>
+          <Button size="sm" variant="outline" onClick={() => setOpen(true)}>
+            {localize('com_ui_library_view')}
+          </Button>
+          <LibraryDialog
+            open={open}
+            onOpenChange={setOpen}
+            conversationId={conversationId}
+            initialId={collect.data.id}
+          />
+        </div>
+      ) : (
+        <Button
+          size="sm"
+          variant="outline"
+          disabled={collect.isLoading}
+          onClick={() =>
+            collect.mutate({
+              conversation_id: conversationId,
+              message_id: messageId,
+              operation_key: operationKey,
+            })
+          }
+        >
+          {localize(collect.isLoading ? 'com_ui_library_saving' : 'com_ui_library_collect')}
+        </Button>
+      )}
+      {collect.isError && <Failure error={collect.error} />}
+    </div>
+  );
+}
diff --git a/client/src/components/Library/Controls.tsx b/client/src/components/Library/Controls.tsx
new file mode 100644
index 0000000..f932582
--- /dev/null
+++ b/client/src/components/Library/Controls.tsx
@@ -0,0 +1,50 @@
+import { useLocation } from 'react-router-dom';
+import type { TMessage } from 'librechat-data-provider';
+import { useGetStartupConfig } from '~/data-provider';
+import { useAuthContext } from '~/hooks/AuthContext';
+import Collect from './Collect';
+import Turn from './Turn';
+
+/** Shared/share pages have no authenticated personal-library controls. */
+export default function Controls({
+  message,
+  isSubmitting,
+  isSearchView,
+}: {
+  message: TMessage;
+  isSubmitting: boolean;
+  isSearchView?: boolean;
+}) {
+  const { isAuthenticated } = useAuthContext();
+  const { data: startupConfig } = useGetStartupConfig();
+  const { pathname } = useLocation();
+  if (
+    !isAuthenticated ||
+    startupConfig?.interface?.library !== true ||
+    pathname.startsWith('/share/') ||
+    isSearchView ||
+    !message.conversationId ||
+    message.conversationId === 'new' ||
+    !message.messageId
+  ) {
+    return null;
+  }
+  return (
+    <div className="mx-auto max-w-3xl">
+      {message.isCreatedByUser ? (
+        <Collect
+          key={message.messageId}
+          conversationId={message.conversationId}
+          messageId={message.messageId}
+        />
+      ) : (
+        <Turn
+          key={message.messageId}
+          conversationId={message.conversationId}
+          messageId={message.messageId}
+          isSubmitting={isSubmitting}
+        />
+      )}
+    </div>
+  );
+}
