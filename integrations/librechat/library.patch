+        status: 'pending',
+      },
+    ],
+  });
+  render(<Turn conversationId="chat1" messageId="user1" isSubmitting={false} />, {
+    wrapper: Wrapper,
+  });
+  fireEvent.click(await screen.findByText('com_ui_library_dismiss'));
+  await screen.findByText('com_ui_library_draft_dismissed');
+  expect(service.dismissDraft).toHaveBeenCalledWith(3);
+  expect(service.confirmDraft).not.toHaveBeenCalled();
+});
+
+test('generation completion fetches the turn without permanent history polling', async () => {
+  const view = render(<Turn conversationId="chat1" messageId="user1" isSubmitting />, {
+    wrapper: Wrapper,
+  });
+  expect(service.turn).not.toHaveBeenCalled();
+  view.rerender(<Turn conversationId="chat1" messageId="user1" isSubmitting={false} />);
+  await waitFor(() => expect(service.turn).toHaveBeenCalledTimes(1));
+  expect(service.turn).toHaveBeenCalledWith('chat1', 'user1');
+  view.rerender(<Turn conversationId="chat1" messageId="user1" isSubmitting={false} />);
+  expect(service.turn).toHaveBeenCalledTimes(1);
+  jest.useFakeTimers();
+  await act(async () => {
+    jest.advanceTimersByTime(60000);
+  });
+  expect(service.turn).toHaveBeenCalledTimes(1);
+  jest.useRealTimers();
+});
+
+test('assistant controls fetch the assistant ID, keeping regenerated turns separate', async () => {
+  const message: TMessage = {
+    messageId: 'assistant1',
+    conversationId: 'chat1',
+    parentMessageId: 'user1',
+    isCreatedByUser: false,
+    text: '回答',
+  };
+  render(
+    <MemoryRouter initialEntries={['/c/chat1']}>
+      <Controls message={message} isSubmitting={false} />
+    </MemoryRouter>,
+    { wrapper: Wrapper },
+  );
+  await waitFor(() => expect(service.turn).toHaveBeenCalledWith('chat1', 'assistant1'));
+  expect(service.turn).not.toHaveBeenCalledWith('chat1', 'user1');
+});
+
+test('shared pages do not read the personal library', () => {
+  const message: TMessage = {
+    messageId: 'assistant1',
+    conversationId: 'chat1',
+    parentMessageId: 'user1',
+    isCreatedByUser: false,
+    text: '分享的回答',
+  };
+  render(
+    <MemoryRouter initialEntries={['/share/public']}>
+      <Controls message={message} isSubmitting={false} />
+    </MemoryRouter>,
+    { wrapper: Wrapper },
+  );
+  expect(service.turn).not.toHaveBeenCalled();
+});
+
+test('failed collection shows a retryable error and never a saved receipt', async () => {
+  service.collect.mockRejectedValue(new Error('offline'));
+  render(<Collect conversationId="chat1" messageId="user1" />, { wrapper: Wrapper });
+  fireEvent.click(screen.getByText('com_ui_library_collect'));
+  await screen.findByRole('alert');
+  expect(screen.queryByText('com_ui_library_collected')).not.toBeInTheDocument();
+  expect(screen.getByText('com_ui_library_collect')).toBeEnabled();
+});
