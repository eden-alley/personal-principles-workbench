+
+describe('library authenticated proxy', () => {
+  const owner = 'a'.repeat(24);
+  const getMessages = jest.fn();
+  const getFiles = jest.fn();
+  const getLocalFileStream = jest.fn();
+  let fetchMock: jest.SpyInstance;
+  const app = express();
+  app.use(express.json({ limit: '3mb' }));
+  app.use(
+    '/api/library',
+    createLibraryRouter({
+      token: 'internal-test-token',
+      requireAuth: (req, _res, next) => {
+        req.user = { id: owner };
+        next();
+      },
+      configMiddleware: (req, _res, next) => {
+        Object.assign(req, { config: { interfaceConfig: { library: true } } });
+        next();
+      },
+      getMessages,
+      getFiles,
+      getLocalFileStream,
+    }),
+  );
+  beforeEach(() => {
+    jest.clearAllMocks();
+    fetchMock = jest.spyOn(global, 'fetch');
+    fetchMock.mockResolvedValue(new Response(JSON.stringify({ entries: [] }), { status: 200 }));
+  });
+  afterEach(() => {
+    fetchMock.mockRestore();
+  });
+
+  it('uses authenticated ownership and a fixed internal peer', async () => {
+    await request(app)
+      .get('/api/library?owner=attacker')
+      .set('X-Library-Owner', 'attacker')
+      .expect(200);
+    expect(fetchMock.mock.calls[0][0]).toBe('http://127.0.0.1:8768/library/?');
+    expect(new Headers(fetchMock.mock.calls[0][1]?.headers).get('X-Library-Owner')).toBe(owner);
+  });
+
+  it('rejects cross-origin writes before reading messages', async () => {
+    await request(app)
+      .post('/api/library/collect')
+      .set('Origin', 'https://evil.invalid')
+      .send({ conversation_id: 'chat', message_id: 'message', operation_key: 'test' })
+      .expect(403);
+    expect(getMessages).not.toHaveBeenCalled();
+  });
+
+  it('cannot collect an unowned message or browser supplied attachment', async () => {
+    getMessages.mockResolvedValue([]);
+    await request(app)
+      .post('/api/library/collect')
+      .send({
+        conversation_id: 'chat',
+        message_id: 'message',
+        operation_key: 'test',
+        assets: [{ filepath: 'C:/private.txt' }],
+      })
+      .expect(404);
+    expect(getMessages).toHaveBeenCalledWith({
+      user: owner,
+      conversationId: 'chat',
+      messageId: 'message',
+    });
+    expect(fetchMock).not.toHaveBeenCalled();
+  });
+
+  it('copies only persisted user text and fails safely on operational errors', async () => {
+    getMessages.mockResolvedValue([{ isCreatedByUser: true, text: 'owned message' }]);
+    await request(app)
+      .post('/api/library/collect')
+      .send({
+        conversation_id: 'chat',
+        message_id: 'message',
+        operation_key: 'test',
+        text: 'forged text',
+        owner: 'attacker',
+      })
+      .expect(200);
+    expect(JSON.parse(String(fetchMock.mock.calls[0][1]?.body)).text).toBe('owned message');
+    fetchMock.mockRejectedValue(new Error('secret internal token'));
+    const result = await request(app).get('/api/library').expect(503);
+    expect(result.text).not.toContain('secret');
+  });
+
+  it('accepts a direct source without letting the client inject ownership or filesystem paths', async () => {
+    await request(app)
+      .post('/api/library/sources')
+      .send({
+        text: 'direct source',
+        title: 'title',
+        operation_key: 'test',
+        owner: 'attacker',
+        filepath: 'C:/private.txt',
+        assets: [],
+      })
+      .expect(200);
+    const body = JSON.parse(String(fetchMock.mock.calls[0][1]?.body));
+    expect(body).toEqual({
+      text: 'direct source',
+      title: 'title',
+      operation_key: 'test',
+      assets: [],
+    });
+    expect(getMessages).not.toHaveBeenCalled();
+  });
+
+  it('bounds direct source attachments within the existing JSON body budget', async () => {
+    await request(app)
+      .post('/api/library/sources')
+      .send({
+        operation_key: 'test',
+        assets: [{ name: 'fake.png', mime: 'image/png', data: 'a'.repeat(3_000_000) }],
+      })
+      .expect(413);
+    expect(fetchMock).not.toHaveBeenCalled();
+  });
+
+  it('routes organization requests through authenticated ownership', async () => {
+    await request(app).post('/api/library/entries/3/organize').send({}).expect(200);
+    expect(fetchMock.mock.calls[0][0]).toBe('http://127.0.0.1:8768/library/entries/3/organize?');
+    expect(new Headers(fetchMock.mock.calls[0][1]?.headers).get('X-Library-Owner')).toBe(owner);
+  });
+});
