@@ -0,0 +1,88 @@
+import { useRef } from 'react';
+import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
+import { libraryService, MutationKeys, QueryKeys } from 'librechat-data-provider';
+import type { LibraryEntry, LibraryRequestError } from 'librechat-data-provider';
+import { useAuthContext } from '~/hooks/AuthContext';
+
+export const pendingEntry = (entry: LibraryEntry) =>
+  !entry.removed &&
+  [entry.parse_state, entry.index_state, entry.organization?.state ?? ''].some((state) =>
+    ['pending', 'queued', 'processing', 'running'].includes(state),
+  );
+
+export function useLibraryEntries() {
+  const { user, isAuthenticated } = useAuthContext();
+  return useQuery([QueryKeys.libraryEntries, user?.id], libraryService.list, {
+    enabled: isAuthenticated,
+    refetchInterval: (data) => (data?.entries.some(pendingEntry) ? 3000 : false),
+    refetchIntervalInBackground: false,
+    retry: false,
+  });
+}
+
+export function useLibraryEntry(id?: number) {
+  const { user, isAuthenticated } = useAuthContext();
+  return useQuery([QueryKeys.libraryEntry, user?.id, id], () => libraryService.entry(id ?? 0), {
+    enabled: isAuthenticated && id != null,
+    refetchInterval: (data) => (data && pendingEntry(data) ? 3000 : false),
+    refetchIntervalInBackground: false,
+    retry: false,
+  });
+}
+
+export function useLibraryConversation(conversationId?: string) {
+  const { user, isAuthenticated } = useAuthContext();
+  return useQuery(
+    [QueryKeys.libraryConversation, user?.id, conversationId],
+    () => libraryService.conversation(conversationId ?? ''),
+    { enabled: isAuthenticated && !!conversationId && conversationId !== 'new', retry: false },
+  );
+}
+
+export function useLibraryWrite<TInput = void, TOutput = unknown>(
+  action: string,
+  mutationFn: (input: TInput) => Promise<TOutput>,
+  onSuccess?: (output: TOutput) => void,
+) {
+  const client = useQueryClient();
+  const { user } = useAuthContext();
+  return useMutation<TOutput, LibraryRequestError, TInput>({
+    mutationKey: [MutationKeys.libraryWrite, user?.id, action],
+    mutationFn,
+    retry: false,
+    onSuccess: (data) => {
+      for (const key of [
+        QueryKeys.libraryEntries,
+        QueryKeys.libraryEntry,
+        QueryKeys.libraryConversation,
+      ]) {
+        void client.invalidateQueries([key, user?.id]);
+      }
+      // Historical references are snapshots; a save must not reload every message in view.
+      void client.invalidateQueries({
+        queryKey: [QueryKeys.libraryTurn, user?.id],
+        refetchType: 'none',
+      });
+      onSuccess?.(data);
+    },
+  });
+}
+
+export function useOperationKey() {
+  const operationKey = useRef('');
+  if (!operationKey.current) {
+    operationKey.current = crypto.randomUUID();
+  }
+  return operationKey.current;
+}
+
+export function downloadBlob(blob: Blob, filename: string) {
+  const url = URL.createObjectURL(blob);
+  const link = document.createElement('a');
+  link.href = url;
+  link.download = filename;
+  document.body.append(link);
+  link.click();
+  link.remove();
+  setTimeout(() => URL.revokeObjectURL(url), 1000);
+}
