+            </p>
+          </details>
+          {!!entry.error_code && (
+            <p role="status" className="text-sm text-text-secondary">
+              {localize('com_ui_library_processing_failed')}
+            </p>
+          )}
+          {!entry.removed &&
+            (entry.error_code ||
+              ['failed', 'error'].includes(entry.parse_state) ||
+              ['failed', 'error'].includes(entry.index_state)) && (
+              <Button
+                size="sm"
+                variant="outline"
+                disabled={retry.isLoading}
+                onClick={() => retry.mutate(entry.id)}
+              >
+                {localize('com_ui_library_retry_processing')}
+              </Button>
+            )}
+          <ul className="space-y-2">
+            {entry.assets.map((file) => (
+              <li key={file.id}>
+                <Button
+                  size="sm"
+                  variant="outline"
+                  className="max-w-full"
+                  disabled={asset.isLoading}
+                  onClick={() => asset.mutate(file)}
+                >
+                  <span className="truncate">
+                    {localize('com_ui_library_download', { name: file.name })}
+                  </span>
+                </Button>
+              </li>
+            ))}
+          </ul>
+        </>
