+import axios from 'axios';
+import { apiBaseUrl } from './api-endpoints';
+import request from './request';
+
+export type LibraryKind = 'source' | 'principle' | 'experience';
+export type LibraryAsset = { id: number; name: string; mime: string; size: number };
+export type LibraryOrganization = {
+  state: string;
+  title?: string;
+  summary?: string;
+  key_points?: { text: string; quote: string }[];
+  topics?: string[];
+  relations?: {
+    entry_id: number;
+    kind: 'similar' | 'complements' | 'contradicts';
+    explanation: string;
+    quote: string;
+    related_quote: string;
+  }[];
+  limitations?: string;
+  error_code?: string;
+  source_revision?: number;
+};
+export type LibrarySourceInput = {
+  text?: string;
+  title?: string;
+  url?: string;
+  assets: { name: string; mime: string; data: string }[];
+  operation_key: string;
+};
+export type LibraryVersion = {
+  version: number;
+  title: string;
+  text: string;
+  status: string;
+  reason: string;
+  when_to_use: string;
+  boundaries: string;
+  created_at: string;
+  source_ids: number[];
+  experience_ids: number[];
+  evidence: { id: number; kind: LibraryKind; revision: number; excerpt: string }[];
+};
+export type LibraryEntry = {
+  id: number;
+  kind: LibraryKind;
+  title: string;
+  text: string;
+  revision: number;
+  removed: boolean;
+  parse_state: string;
+  index_state: string;
+  error_code?: string | null;
+  assets: LibraryAsset[];
+  versions: LibraryVersion[];
+  source_ids: number[];
+  experience_ids: number[];
+  reason?: string;
+  transcript?: string;
+  version?: number;
+  organization?: LibraryOrganization;
+};
+export type LibraryReference = {
+  id: number;
+  kind: LibraryKind;
+  label: string;
+  title: string;
+  revision: number;
+  version?: number;
+  excerpt: string;
+};
+export type LibraryDraft = {
+  id: number;
+  payload: {
+    kind: LibraryKind;
+    text: string;
+    reason?: string;
+    source_ids: number[];
+    experience_ids: number[];
+    entry_id?: number;
+    expected_revision?: number;
+  };
+  status: 'pending' | 'saved' | 'dismissed';
+  entry_id?: number;
+};
+export type LibraryTurn = {
+  references: LibraryReference[];
+  notice?: string | null;
+  completed: boolean;
+  drafts: LibraryDraft[];
+};
+export type LibraryConversation = {
+  selected_ids: number[];
+  excluded_ids: number[];
+  proposals_enabled: boolean;
+};
+export type LibraryPrincipleInput = {
+  statement: string;
+  entry_id?: number;
+  expected_revision?: number;
+  reason?: string;
+  source_ids?: number[];
+  experience_ids?: number[];
+  confirmed: true;
+  operation_key: string;
+};
+
+export class LibraryRequestError extends Error {
+  constructor(public readonly status: number) {
+    super('Library request failed');
+    this.name = 'LibraryRequestError';
+  }
+}
+
+async function safely<T>(operation: () => Promise<T>): Promise<T> {
+  try {
+    return await operation();
+  } catch (error) {
+    throw new LibraryRequestError(axios.isAxiosError(error) ? (error.response?.status ?? 0) : 0);
+  }
+}
+
+const root = () => `${apiBaseUrl()}/api/library`;
+const entryPath = (id: number) => `${root()}/entries/${encodeURIComponent(id)}`;
+const post = <T>(path: string, body: object): Promise<T> => safely(() => request.post(path, body));
+
+/** Uses LibreChat's authenticated request and refresh handling for every library request. */
+export const libraryService = {
+  list: (): Promise<{ entries: LibraryEntry[] }> => safely(() => request.get(root())),
+  entry: (id: number): Promise<LibraryEntry> => safely(() => request.get(entryPath(id))),
+  collect: (body: { conversation_id: string; message_id: string; operation_key: string }) =>
+    post<LibraryEntry>(`${root()}/collect`, body),
+  addSource: (body: LibrarySourceInput) => post<LibraryEntry>(`${root()}/sources`, body),
+  organize: (id: number) => post<LibraryEntry>(`${entryPath(id)}/organize`, {}),
+  principle: (body: LibraryPrincipleInput) => post<LibraryEntry>(`${root()}/principles`, body),
+  experience: (body: { facts: string; confirmed: true; operation_key: string }) =>
+    post<LibraryEntry>(`${root()}/experiences`, body),
+  remove: (id: number, body: { removed: boolean; expected_revision: number; confirmed: true }) =>
+    post<LibraryEntry>(`${entryPath(id)}/remove`, body),
+  retry: (id: number) => post<LibraryEntry>(`${entryPath(id)}/retry`, {}),
+  turn: (conversationId: string, messageId: string): Promise<LibraryTurn> =>
+    safely(() =>
+      request.get(
+        `${root()}/turn?${new URLSearchParams({ conversation_id: conversationId, message_id: messageId })}`,
+      ),
+    ),
+  conversation: (id: string): Promise<LibraryConversation> =>
+    safely(() =>
+      request.get(`${root()}/conversation?${new URLSearchParams({ conversation_id: id })}`),
+    ),
+  updateConversation: (body: Partial<LibraryConversation> & { conversation_id: string }) =>
+    post<LibraryConversation>(`${root()}/conversation`, body),
+  confirmDraft: (id: number, body: { text: string; confirmed: true; operation_key: string }) =>
+    post<LibraryEntry>(`${root()}/drafts/${encodeURIComponent(id)}/confirm`, body),
+  dismissDraft: (id: number) =>
+    post<{ status: string }>(`${root()}/drafts/${encodeURIComponent(id)}/dismiss`, {}),
+  export: (): Promise<object> => safely(() => request.get(`${root()}/export`)),
+  asset: (id: number): Promise<Blob> =>
+    safely(() =>
+      request.get(`${root()}/assets/${encodeURIComponent(id)}`, { responseType: 'blob' }),
+    ),
+};
