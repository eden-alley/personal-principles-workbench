+import { Button } from '@librechat/client';
+import { libraryService } from 'librechat-data-provider';
+import type { LibraryEntry } from 'librechat-data-provider';
+import { useLibraryWrite } from './hooks';
+import { useLocalize } from '~/hooks';
+import { Failure } from './Feedback';
+
+export default function Organization({
+  entry,
+  entries,
+  onOpen,
+}: {
+  entry: LibraryEntry;
+  entries: LibraryEntry[];
+  onOpen?: (id: number) => void;
+}) {
+  const localize = useLocalize();
+  const organize = useLibraryWrite('organize', libraryService.organize);
+  const value = entry.organization;
+  const state = value?.state ?? 'not_started';
+  const pending = ['pending', 'running'].includes(state);
+  const ready = state === 'ready';
+  const states = {
+    blocked: 'com_ui_library_organization_blocked',
+    failed: 'com_ui_library_organization_failed',
+    stale: 'com_ui_library_organization_stale',
+  } as const;
+  const stateLabel = pending
+    ? 'com_ui_library_organization_pending'
+    : (states[state as keyof typeof states] ?? 'com_ui_library_organization_not_started');
+  const labels = {
+    similar: 'com_ui_library_relation_similar',
+    complements: 'com_ui_library_relation_complements',
+    contradicts: 'com_ui_library_relation_contradicts',
+  } as const;
+  return (
+    <section
+      className="space-y-3 rounded-lg border border-border-light p-3"
+      aria-label={localize('com_ui_library_organization')}
+    >
+      <h4 className="text-sm font-semibold">{localize('com_ui_library_organization')}</h4>
+      <p className="text-xs text-text-secondary">{localize('com_ui_library_organization_hint')}</p>
+      {!ready && (
+        <p role="status" className="text-sm text-text-secondary">
+          {localize(stateLabel)}
+        </p>
+      )}
+      {value?.summary && (
+        <>
+          {!ready && (
+            <p className="text-xs text-text-secondary">
+              {localize('com_ui_library_organization_previous')}
+            </p>
+          )}
+          {value.title && <h5 className="break-words text-sm font-semibold">{value.title}</h5>}
+          <p className="whitespace-pre-wrap break-words text-sm">{value.summary}</p>
+          {!!value.topics?.length && (
+            <p className="break-words text-xs text-text-secondary">{value.topics.join(' · ')}</p>
+          )}
+          <ul className="space-y-3">
+            {value.key_points?.map((point, index) => (
+              <li key={index} className="text-sm">
+                <p className="break-words">{point.text}</p>
+                <details className="mt-1 text-text-secondary">
+                  <summary className="cursor-pointer text-xs">
+                    {localize('com_ui_library_point_evidence')}
+                  </summary>
+                  <blockquote className="mt-2 whitespace-pre-wrap break-words border-l-2 border-border-light pl-3">
+                    {point.quote}
+                  </blockquote>
+                </details>
+              </li>
+            ))}
+          </ul>
+          {!!value.relations?.length && (
+            <div className="space-y-3 border-t border-border-light pt-3">
+              <h5 className="text-sm font-medium">{localize('com_ui_library_related_sources')}</h5>
+              {value.relations.map((relation) => {
+                const target = entries.find((item) => item.id === relation.entry_id);
+                return (
+                  <div key={relation.entry_id} className="space-y-1 text-sm">
+                    <p className="font-medium">{localize(labels[relation.kind])}</p>
+                    {onOpen ? (
+                      <button
+                        type="button"
+                        onClick={() => onOpen(relation.entry_id)}
+                        className="break-words text-left underline underline-offset-2"
+                      >
+                        {target?.organization?.title || target?.title || String(relation.entry_id)}
+                      </button>
+                    ) : (
+                      <p>{target?.title || String(relation.entry_id)}</p>
+                    )}
+                    <p className="break-words">{relation.explanation}</p>
+                    <details className="text-text-secondary">
+                      <summary className="cursor-pointer text-xs">
+                        {localize('com_ui_library_relation_evidence')}
+                      </summary>
+                      <blockquote className="mt-2 whitespace-pre-wrap break-words border-l-2 border-border-light pl-3">
+                        {relation.quote}
+                      </blockquote>
+                      <blockquote className="mt-2 whitespace-pre-wrap break-words border-l-2 border-border-light pl-3">
+                        {relation.related_quote}
+                      </blockquote>
+                    </details>
+                  </div>
+                );
+              })}
+            </div>
+          )}
+          {value.limitations && (
+            <p className="break-words text-xs text-text-secondary">{value.limitations}</p>
+          )}
+        </>
+      )}
+      {!entry.removed && !pending && (
+        <Button
+          size="sm"
+          variant="outline"
+          disabled={organize.isLoading}
+          onClick={() => organize.mutate(entry.id)}
+        >
+          {localize(
+            state === 'failed' || value?.summary
+              ? 'com_ui_library_organize_retry'
+              : 'com_ui_library_organize_now',
+          )}
+        </Button>
+      )}
+      {organize.isError && <Failure error={organize.error} />}
+    </section>
+  );
+}
diff --git a/client/src/components/Library/SourceEditor.tsx b/client/src/components/Library/SourceEditor.tsx
