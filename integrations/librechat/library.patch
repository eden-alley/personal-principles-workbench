+      {!!entry.reason && (
+        <section className="space-y-1">
+          <h4 className="text-sm font-medium">{localize('com_ui_library_reason')}</h4>
+          <p className="whitespace-pre-wrap break-words text-sm">{entry.reason}</p>
+        </section>
+      )}
+      {linked.length > 0 && (
+        <section className="space-y-1">
+          <h4 className="text-sm font-medium">{localize('com_ui_library_associations')}</h4>
+          <ul className="space-y-1 text-sm text-text-secondary">
+            {linked.map((linkedId) => (
+              <li key={linkedId}>
+                {entries.find((item) => item.id === linkedId)?.title || String(linkedId)}
+              </li>
+            ))}
+          </ul>
+        </section>
+      )}
+      {entry.versions.length > 0 && (
+        <details>
+          <summary className="cursor-pointer text-sm font-medium">
+            {localize('com_ui_library_versions')}
+          </summary>
+          <ol className="mt-3 space-y-4">
+            {entry.versions.map((version) => (
+              <li key={version.version} className="space-y-1 text-sm">
+                <p className="font-medium">
+                  {localize('com_ui_library_version', { version: version.version })} ·{' '}
+                  {version.created_at}
+                </p>
+                {version.title && <p className="font-medium">{version.title}</p>}
+                <PrincipleStatus status={version.status} />
+                <p className="whitespace-pre-wrap break-words">{version.text}</p>
+                {version.reason && (
+                  <p className="whitespace-pre-wrap break-words text-text-secondary">
+                    {version.reason}
+                  </p>
+                )}
+                {(version.when_to_use || version.boundaries) && (
+                  <dl className="space-y-2 text-text-secondary">
+                    {version.when_to_use && (
+                      <div>
+                        <dt className="font-medium">{localize('com_ui_library_when_to_use')}</dt>
+                        <dd className="whitespace-pre-wrap break-words">{version.when_to_use}</dd>
+                      </div>
+                    )}
+                    {version.boundaries && (
+                      <div>
+                        <dt className="font-medium">{localize('com_ui_library_boundaries')}</dt>
+                        <dd className="whitespace-pre-wrap break-words">{version.boundaries}</dd>
+                      </div>
+                    )}
+                  </dl>
+                )}
+                {!!version.evidence?.length && (
+                  <details className="pt-2">
+                    <summary className="cursor-pointer font-medium">
+                      {localize('com_ui_library_version_evidence', {
+                        count: version.evidence.length,
+                      })}
+                    </summary>
+                    <p className="mt-2 text-text-secondary">
+                      {localize('com_ui_library_version_evidence_hint')}
+                    </p>
+                    <ul className="mt-3 space-y-3">
+                      {version.evidence.map((evidence) => (
+                        <li
+                          key={`${evidence.kind}-${evidence.id}-${evidence.revision}`}
+                          className="space-y-1"
+                        >
+                          <p className="break-words font-medium">
+                            {kindLabel(evidence.kind)} ·{' '}
+                            {entries.find((item) => item.id === evidence.id)?.title ||
+                              String(evidence.id)}{' '}
+                            · {localize('com_ui_library_revision', { revision: evidence.revision })}
+                          </p>
+                          <p className="whitespace-pre-wrap break-words text-text-secondary">
+                            {evidence.excerpt}
+                          </p>
+                        </li>
+                      ))}
+                    </ul>
+                  </details>
+                )}
+              </li>
+            ))}
+          </ol>
+        </details>
+      )}
+      {!entry.removed && conversation && (
+        <fieldset className="space-y-3 border-t border-border-light pt-4">
+          <legend className="sr-only">{localize('com_ui_library_conversation')}</legend>
+          <label className="flex items-start gap-2 text-sm">
+            <input
+              type="checkbox"
+              checked={selected}
+              disabled={conversationBusy || (!selected && selectedIds.length >= 5)}
+              onChange={(event) =>
+                onConversationChange({
+                  selected_ids: event.target.checked
+                    ? [...selectedIds, entry.id]
+                    : selectedIds.filter((value) => value !== entry.id),
+                  excluded_ids: excludedIds.filter((value) => value !== entry.id),
+                })
+              }
+              className="mt-1"
+            />
+            <span>{localize('com_ui_library_select_conversation')}</span>
+          </label>
+          <label className="flex items-start gap-2 text-sm">
+            <input
+              type="checkbox"
+              checked={excluded}
+              disabled={conversationBusy}
+              onChange={(event) =>
+                onConversationChange({
+                  excluded_ids: event.target.checked
+                    ? [...excludedIds, entry.id]
+                    : excludedIds.filter((value) => value !== entry.id),
+                  selected_ids: selectedIds.filter((value) => value !== entry.id),
+                })
+              }
+              className="mt-1"
+            />
+            <span>{localize('com_ui_library_exclude_conversation')}</span>
+          </label>
+        </fieldset>
+      )}
+      <div className="flex flex-wrap gap-2 border-t border-border-light pt-4">
+        {entry.kind === 'principle' && !entry.removed && (
+          <Button size="sm" variant="outline" onClick={() => onEdit(entry)}>
+            {localize('com_ui_library_edit_principle')}
+          </Button>
+        )}
+        {entry.removed ? (
+          <Button
+            size="sm"
+            variant="outline"
+            disabled={remove.isLoading}
+            onClick={() => remove.mutate({ entry, removed: false })}
+          >
+            {localize('com_ui_library_restore')}
+          </Button>
+        ) : (
+          <Button
+            size="sm"
+            variant="outline"
+            disabled={remove.isLoading}
+            onClick={() => setRemoving(true)}
+          >
+            {localize('com_ui_library_remove')}
+          </Button>
+        )}
+      </div>
+      {removing && !entry.removed && (
+        <form
+          className="space-y-3"
+          onSubmit={(event) => {
+            event.preventDefault();
+            if (confirmation === exactTitle && !remove.isLoading) {
+              remove.mutate({ entry, removed: true });
+            }
+          }}
+        >
+          <p className="text-sm text-text-secondary">{localize('com_ui_library_remove_hint')}</p>
+          <Label htmlFor={`${id}-remove`}>
+            {localize('com_ui_library_remove_confirm', { title: exactTitle })}
+          </Label>
+          <Input
+            id={`${id}-remove`}
+            value={confirmation}
+            onChange={(event) => setConfirmation(event.target.value)}
+            disabled={remove.isLoading}
+          />
+          <div className="flex flex-wrap gap-2">
+            <Button
+              type="button"
+              size="sm"
+              variant="outline"
+              onClick={() => {
+                setRemoving(false);
+                setConfirmation('');
+              }}
+            >
+              {localize('com_ui_cancel')}
+            </Button>
+            <Button
+              type="submit"
+              size="sm"
+              variant="destructive"
+              disabled={confirmation !== exactTitle || remove.isLoading}
+            >
+              {localize('com_ui_library_confirm_remove')}
+            </Button>
+          </div>
+        </form>
+      )}
+      {remove.isError && <Failure error={remove.error} />}
+      {retry.isError && <Failure error={retry.error} />}
+      {asset.isError && <Failure />}
+    </article>
+  );
+}
