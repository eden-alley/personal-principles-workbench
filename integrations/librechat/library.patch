@@ -0,0 +1,36 @@
+import { Button, Spinner } from '@librechat/client';
+import { LibraryRequestError } from 'librechat-data-provider';
+import { useLocalize } from '~/hooks';
+
+export function Loading() {
+  const localize = useLocalize();
+  return (
+    <div role="status" className="flex items-center gap-2 py-4 text-sm text-text-secondary">
+      <Spinner className="size-4" />
+      {localize('com_ui_library_loading')}
+    </div>
+  );
+}
+
+export function Failure({ error, retry }: { error?: Error | null; retry?: () => void }) {
+  const localize = useLocalize();
+  const status = error instanceof LibraryRequestError ? error.status : 0;
+  let key: 'com_ui_library_conflict' | 'com_ui_library_too_large' | 'com_ui_library_error' =
+    'com_ui_library_error';
+  if (status === 409) {
+    key = 'com_ui_library_conflict';
+  }
+  if (status === 413) {
+    key = 'com_ui_library_too_large';
+  }
+  return (
+    <div role="alert" className="space-y-2 py-2 text-sm text-text-secondary">
+      <p>{localize(key)}</p>
+      {retry && (
+        <Button size="sm" variant="outline" onClick={retry}>
+          {localize('com_ui_library_retry')}
+        </Button>
+      )}
+    </div>
+  );
+}
