index 0000000..d7a1b70
--- /dev/null
+++ b/client/src/components/Library/SourceEditor.tsx
@@ -0,0 +1,152 @@
+import { useId, useState } from 'react';
+import { Button, Input, Label, Textarea } from '@librechat/client';
+import { libraryService } from 'librechat-data-provider';
+import type { LibraryEntry, LibrarySourceInput } from 'librechat-data-provider';
+import { useOperationKey, useLibraryWrite } from './hooks';
+import { useLocalize } from '~/hooks';
+import { Failure } from './Feedback';
+
+function readFile(file: File): Promise<LibrarySourceInput['assets'][number]> {
+  return new Promise((resolve, reject) => {
+    const reader = new FileReader();
+    reader.onerror = () => reject(new Error('file_read_failed'));
+    reader.onload = () => {
+      const extensions: Record<string, string> = {
+        png: 'image/png',
+        jpg: 'image/jpeg',
+        jpeg: 'image/jpeg',
+        webp: 'image/webp',
+        txt: 'text/plain',
+        md: 'text/markdown',
+      };
+      const mime = Object.values(extensions).includes(file.type)
+        ? file.type
+        : extensions[file.name.split('.').pop()?.toLowerCase() ?? ''];
+      if (!mime) {
+        reject(new Error('unsupported_file'));
+        return;
+      }
+      resolve({ name: file.name, mime, data: String(reader.result).split(',')[1] });
+    };
+    reader.readAsDataURL(file);
+  });
+}
+
+export default function SourceEditor({
+  onSaved,
+  onCancel,
+}: {
+  onSaved: (entry: LibraryEntry) => void;
+  onCancel: () => void;
+}) {
+  const localize = useLocalize();
+  const id = useId();
+  const operationKey = useOperationKey();
+  const [title, setTitle] = useState('');
+  const [text, setText] = useState('');
+  const [url, setUrl] = useState('');
+  const [files, setFiles] = useState<File[]>([]);
+  const [reading, setReading] = useState(false);
+  const [readFailed, setReadFailed] = useState(false);
+  const save = useLibraryWrite('source', libraryService.addSource, onSaved);
+  const tooLarge =
+    files.length > 4 || files.reduce((sum, file) => sum + file.size, 0) > 2 * 1024 * 1024;
+  const busy = reading || save.isLoading;
+  const canSave = !busy && !tooLarge && !!(text.trim() || url.trim() || files.length);
+  return (
+    <form
+      className="space-y-4"
+      onSubmit={async (event) => {
+        event.preventDefault();
+        if (!canSave) {
+          return;
+        }
+        setReading(true);
+        setReadFailed(false);
+        try {
+          const assets = await Promise.all(files.map(readFile));
+          save.mutate({
+            text: text.trim(),
+            title: title.trim(),
+            url: url.trim(),
+            assets,
+            operation_key: operationKey,
+          });
+        } catch {
+          setReadFailed(true);
+        } finally {
+          setReading(false);
+        }
+      }}
+    >
+      <h3 className="font-semibold">{localize('com_ui_library_add_source')}</h3>
+      <p className="text-sm text-text-secondary">{localize('com_ui_library_source_add_hint')}</p>
+      <div className="space-y-2">
+        <Label htmlFor={`${id}-title`}>{localize('com_ui_library_source_title')}</Label>
+        <Input
+          id={`${id}-title`}
+          value={title}
+          maxLength={200}
+          disabled={busy}
+          onChange={(event) => setTitle(event.target.value)}
+        />
+      </div>
+      <div className="space-y-2">
+        <Label htmlFor={`${id}-text`}>{localize('com_ui_library_source_text')}</Label>
+        <Textarea
+          id={`${id}-text`}
+          rows={6}
+          value={text}
+          maxLength={20000}
+          disabled={busy}
+          onChange={(event) => setText(event.target.value)}
+        />
+      </div>
+      <div className="space-y-2">
+        <Label htmlFor={`${id}-url`}>{localize('com_ui_library_source_url')}</Label>
+        <Input
+          id={`${id}-url`}
+          type="url"
+          value={url}
+          maxLength={2000}
+          disabled={busy}
+          onChange={(event) => setUrl(event.target.value)}
+        />
+      </div>
+      <div className="space-y-2">
+        <Label htmlFor={`${id}-files`}>{localize('com_ui_library_source_files')}</Label>
+        <input
+          id={`${id}-files`}
+          type="file"
+          multiple
+          disabled={busy}
+          accept=".png,.jpg,.jpeg,.webp,.txt,.md,image/png,image/jpeg,image/webp,text/plain,text/markdown"
+          onChange={(event) => setFiles(Array.from(event.target.files ?? []))}
+          className="block w-full min-w-0 text-sm"
+        />
+        <p className="text-xs text-text-secondary">
+          {localize('com_ui_library_source_files_hint')}
+        </p>
+      </div>
+      {tooLarge && (
+        <p role="alert" className="text-sm">
+          {localize('com_ui_library_source_files_limit')}
+        </p>
+      )}
+      {readFailed && (
+        <p role="alert" className="text-sm">
+          {localize('com_ui_library_source_read_failed')}
+        </p>
+      )}
+      {save.isError && <Failure error={save.error} />}
+      <div className="flex flex-wrap justify-end gap-2">
+        <Button type="button" variant="outline" disabled={busy} onClick={onCancel}>
+          {localize('com_ui_cancel')}
+        </Button>
+        <Button type="submit" disabled={!canSave}>
+          {localize(busy ? 'com_ui_library_saving' : 'com_ui_library_save_organize')}
+        </Button>
+      </div>
+    </form>
+  );
+}
