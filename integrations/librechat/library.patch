+import { libraryService, QueryKeys } from 'librechat-data-provider';
+import type { LibraryDraft } from 'librechat-data-provider';
+import { useLibraryConversation, useLibraryWrite, useOperationKey } from './hooks';
+import { useAuthContext } from '~/hooks/AuthContext';
+import { Failure, Loading } from './Feedback';
+import { useKindLabel } from './Entry';
+import { useLocalize } from '~/hooks';
+import LibraryDialog from './Dialog';
+
+function Draft({ draft }: { draft: LibraryDraft }) {
+  const localize = useLocalize();
+  const kindLabel = useKindLabel();
+  const id = useId();
+  const operationKey = useOperationKey();
+  const [text, setText] = useState(draft.payload.text);
+  const confirm = useLibraryWrite('confirmDraft', () =>
+    libraryService.confirmDraft(draft.id, {
+      text: text.trim(),
+      confirmed: true,
+      operation_key: operationKey,
+    }),
+  );
+  const dismiss = useLibraryWrite('dismissDraft', () => libraryService.dismissDraft(draft.id));
+  if (draft.status !== 'pending' || confirm.isSuccess || dismiss.isSuccess) {
+    return (
+      <p role="status" className="text-sm text-text-secondary">
+        {localize(
+          draft.status === 'saved' || confirm.isSuccess
+            ? 'com_ui_library_draft_saved'
+            : 'com_ui_library_draft_dismissed',
+        )}
+      </p>
+    );
+  }
+  const busy = confirm.isLoading || dismiss.isLoading;
+  return (
+    <form
+      className="space-y-3 border-t border-border-light pt-3"
+      onSubmit={(event) => {
+        event.preventDefault();
+        if (text.trim() && !busy) {
+          confirm.mutate();
+        }
+      }}
+    >
+      <Label htmlFor={`${id}-draft`}>
+        {localize('com_ui_library_draft_label', { kind: kindLabel(draft.payload.kind) })}
+      </Label>
+      <p className="text-sm text-text-secondary">
+        {localize(
+          draft.payload.entry_id
+            ? 'com_ui_library_revision_draft_hint'
+            : 'com_ui_library_draft_hint',
+        )}
+      </p>
+      <Textarea
+        id={`${id}-draft`}
+        value={text}
+        onChange={(event) => setText(event.target.value)}
+        rows={3}
+        required
+        disabled={busy}
+      />
+      {draft.payload.reason && (
+        <p className="whitespace-pre-wrap break-words text-sm text-text-secondary">
+          {draft.payload.reason}
+        </p>
+      )}
+      <div className="flex flex-wrap gap-2">
+        <Button type="submit" size="sm" disabled={busy || !text.trim()}>
+          {localize(confirm.isLoading ? 'com_ui_library_saving' : 'com_ui_library_confirm_save')}
+        </Button>
+        <Button
+          type="button"
+          size="sm"
+          variant="outline"
+          disabled={busy}
+          onClick={() => dismiss.mutate()}
+        >
+          {localize('com_ui_library_dismiss')}
+        </Button>
+      </div>
+      {confirm.isError && <Failure error={confirm.error} />}
+      {dismiss.isError && <Failure error={dismiss.error} />}
+    </form>
+  );
+}
+
+export default function Turn({
+  conversationId,
+  messageId,
+  isSubmitting,
+}: {
+  conversationId: string;
+  messageId: string;
+  isSubmitting: boolean;
+}) {
+  const localize = useLocalize();
+  const kindLabel = useKindLabel();
+  const { user, isAuthenticated } = useAuthContext();
+  const [detailId, setDetailId] = useState<number>();
+  const [expanded, setExpanded] = useState(false);
+  const wasSubmitting = useRef(isSubmitting);
+  const turn = useQuery(
+    [QueryKeys.libraryTurn, user?.id, conversationId, messageId],
+    () => libraryService.turn(conversationId, messageId),
+    {
+      enabled: isAuthenticated && !isSubmitting,
+      staleTime: 30000,
+      retry: false,
+      refetchOnWindowFocus: false,
+    },
+  );
+  const conversation = useLibraryConversation(expanded ? conversationId : undefined);
+  const update = useLibraryWrite('exclude', libraryService.updateConversation);
+  const { refetch } = turn;
+  useEffect(() => {
+    if (wasSubmitting.current && !isSubmitting && isAuthenticated) {
+      void refetch();
+    }
+    wasSubmitting.current = isSubmitting;
+  }, [isSubmitting, isAuthenticated, refetch]);
+  if (isSubmitting) {
+    return null;
+  }
+  if (turn.isLoading) {
+    return null;
+  }
+  if (turn.isError) {
+    return (
+      <details className="mt-3 text-sm text-text-secondary">
+        <summary className="cursor-pointer">{localize('com_ui_library_turn_unavailable')}</summary>
+        <Failure
+          error={turn.error instanceof Error ? turn.error : undefined}
+          retry={() => void turn.refetch()}
+        />
+      </details>
+    );
+  }
+  const data = turn.data;
+  if (!data || (!data.notice && !data.references.length && !data.drafts.length)) {
+    return null;
+  }
+  return (
+    <aside className="mt-3 space-y-3 text-sm">
+      {data.notice && (
+        <p role="status" className="text-text-secondary">
+          {data.notice}
+        </p>
+      )}
+      {data.references.length > 0 && (
+        <details open={expanded} onToggle={(event) => setExpanded(event.currentTarget.open)}>
+          <summary className="cursor-pointer text-text-secondary">
+            {localize('com_ui_library_references', { count: data.references.length })}
+          </summary>
+          <ul className="mt-3 space-y-4">
+            {data.references.map((reference) => {
+              const excluded = conversation.data?.excluded_ids.includes(reference.id);
+              return (
+                <li
+                  key={`${reference.id}-${reference.version ?? reference.revision}`}
+                  className="space-y-2"
+                >
+                  <p className="break-words font-medium">
+                    {reference.label} · {kindLabel(reference.kind)} · {reference.title}
+                    {reference.version != null && (
+                      <> · {localize('com_ui_library_version', { version: reference.version })}</>
+                    )}
+                  </p>
+                  {reference.kind === 'source' && (
+                    <p className="text-text-secondary">{localize('com_ui_library_source_hint')}</p>
+                  )}
+                  <p className="whitespace-pre-wrap break-words text-text-secondary">
+                    {reference.excerpt}
+                  </p>
+                  <div className="flex flex-wrap gap-2">
+                    <Button size="sm" variant="outline" onClick={() => setDetailId(reference.id)}>
+                      {localize('com_ui_library_view')}
+                    </Button>
+                    <Button
+                      size="sm"
+                      variant="outline"
+                      disabled={!conversation.data || update.isLoading || excluded}
+                      onClick={() => {
+                        if (conversation.data) {
+                          update.mutate({
+                            conversation_id: conversationId,
+                            excluded_ids: [...conversation.data.excluded_ids, reference.id],
+                            selected_ids: conversation.data.selected_ids.filter(
+                              (id) => id !== reference.id,
+                            ),
+                          });
+                        }
+                      }}
+                    >
+                      {localize(
+                        excluded ? 'com_ui_library_reference_excluded' : 'com_ui_library_exclude',
+                      )}
+                    </Button>
+                  </div>
+                </li>
+              );
+            })}
+          </ul>
+          {conversation.isLoading && <Loading />}
+          {conversation.isError && <Failure retry={() => void conversation.refetch()} />}
+          {update.isError && <Failure error={update.error} />}
+        </details>
+      )}
+      {data.drafts.map((draft) => (
+        <Draft key={draft.id} draft={draft} />
+      ))}
+      <LibraryDialog
+        open={detailId != null}
+        onOpenChange={(open) => {
+          if (!open) {
+            setDetailId(undefined);
+          }
+        }}
+        conversationId={conversationId}
+        initialId={detailId}
+      />
+    </aside>
+  );
+}
