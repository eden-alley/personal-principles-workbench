@@ -0,0 +1,234 @@
+import { Router } from 'express';
+import type { Request, RequestHandler } from 'express';
+import type { Readable } from 'node:stream';
+
+type StoredMessage = {
+  text?: string;
+  isCreatedByUser?: boolean;
+  files?: { file_id?: string }[];
+  attachments?: { file_id?: string }[];
+  content?: { type?: string; text?: string | { value?: string } }[];
+};
+type StoredFile = {
+  file_id: string;
+  filename?: string;
+  type?: string;
+  filepath?: string;
+  source?: string;
+  text?: string;
+};
+type Deps = {
+  token: string;
+  requireAuth: RequestHandler;
+  configMiddleware: RequestHandler;
+  getMessages: (query: {
+    user: string;
+    conversationId: string;
+    messageId: string;
+  }) => Promise<StoredMessage[]>;
+  getFiles: (
+    query: { user: string; file_id: { $in: string[] } },
+    sort: null,
+    select: string,
+  ) => Promise<StoredFile[]>;
+  getLocalFileStream: (req: Request, path: string) => Promise<Readable>;
+};
+
+const readable = /^\/(?:entries\/\d+|assets\/\d+|conversation|turn|export)?$/;
+const writable =
+  /^\/(?:collect|sources|principles|experiences|conversation|entries\/\d+\/(?:remove|retry|organize)|drafts\/\d+\/(?:confirm|dismiss))$/;
+
+export function createLibraryRouter(deps: Deps): Router {
+  const router = Router();
+  router.use(deps.requireAuth, deps.configMiddleware);
+  router.use(
+    async (req: Request & { config?: { interfaceConfig?: { library?: boolean } } }, res) => {
+      if (req.config?.interfaceConfig?.library !== true) {
+        res.status(404).json({ error: { code: 'not_found' } });
+        return;
+      }
+      const owner = req.user && 'id' in req.user ? req.user.id : undefined;
+      if (typeof owner !== 'string' || !/^[a-f\d]{24}$/i.test(owner) || !deps.token) {
+        res.status(401).json({ error: { code: 'unauthorized' } });
+        return;
+      }
+      const post = req.method === 'POST';
+      if ((!post && req.method !== 'GET') || !(post ? writable : readable).test(req.path)) {
+        res.status(404).json({ error: { code: 'not_found' } });
+        return;
+      }
+      if (
+        post &&
+        req.headers.origin &&
+        req.headers.origin !== `${req.protocol}://${req.get('host')}`
+      ) {
+        res.status(403).json({ error: { code: 'forbidden' } });
+        return;
+      }
+      try {
+        let body = req.body;
+        if (post && req.path === '/sources') {
+          const { text, title, url, assets, operation_key } = req.body ?? {};
+          if (
+            typeof operation_key !== 'string' ||
+            [text, title, url].some((value) => value !== undefined && typeof value !== 'string') ||
+            (assets !== undefined && (!Array.isArray(assets) || assets.length > 4))
+          ) {
+            res.status(400).json({ error: { code: 'invalid_request' } });
+            return;
+          }
+          // Stay below the app's existing 3 MB JSON parser; larger files use chat uploads.
+          let total = 0;
+          const copied = [];
+          for (const asset of assets ?? []) {
+            if (
+              !asset ||
+              typeof asset.name !== 'string' ||
+              typeof asset.mime !== 'string' ||
+              typeof asset.data !== 'string'
+            ) {
+              res.status(400).json({ error: { code: 'invalid_request' } });
+              return;
+            }
+            total += Buffer.byteLength(asset.data, 'base64');
+            if (total > 2 * 1024 * 1024) {
+              res.status(413).json({ error: { code: 'file_too_large' } });
+              return;
+            }
+            copied.push({ name: asset.name, mime: asset.mime, data: asset.data });
+          }
+          body = { text, title, url, assets: copied, operation_key };
+        }
+        if (post && req.path === '/collect') {
+          const { conversation_id, message_id, operation_key } = req.body;
+          if (
+            typeof conversation_id !== 'string' ||
+            typeof message_id !== 'string' ||
+            typeof operation_key !== 'string'
+          ) {
+            res.status(400).json({ error: { code: 'invalid_request' } });
+            return;
+          }
+          const messages = await deps.getMessages({
+            user: owner,
+            conversationId: conversation_id,
+            messageId: message_id,
+          });
+          const message = messages[0];
+          if (!message || !message.isCreatedByUser) {
+            res.status(404).json({ error: { code: 'message_not_found' } });
+            return;
+          }
+          const ids = [
+            ...new Set(
+              [...(message.files ?? []), ...(message.attachments ?? [])]
+                .map((file) => file.file_id)
+                .filter((id): id is string => typeof id === 'string'),
+            ),
+          ];
+          if (ids.length > 4) {
+            res.status(400).json({ error: { code: 'too_many_files' } });
+            return;
+          }
+          const files = ids.length
+            ? await deps.getFiles(
+                { user: owner, file_id: { $in: ids } },
+                null,
+                'file_id filename type filepath source text',
+              )
+            : [];
+          if (files.length !== ids.length) {
+            res.status(404).json({ error: { code: 'file_not_found' } });
+            return;
+          }
+          const assets: { name: string; mime: string; data: string }[] = [];
+          let total = 0;
+          for (const file of files) {
+            const mime = file.type ?? '';
+            if (
+              !['image/png', 'image/jpeg', 'image/webp', 'text/plain', 'text/markdown'].includes(
+                mime,
+              )
+            ) {
+              res.status(400).json({ error: { code: 'unsupported_file' } });
+              return;
+            }
+            let buffer: Buffer;
+            if (file.source === 'text' && typeof file.text === 'string') {
+              buffer = Buffer.from(file.text, 'utf8');
+            } else {
+              // Only this pilot's local, account-owned files; no remote URL fetch or client paths.
+              if (
+                file.source !== 'local' ||
+                !file.filepath ||
+                !new RegExp(`^/(?:images|uploads)/${owner}/`).test(file.filepath) ||
+                file.filepath.includes('..') ||
+                file.filepath.includes('\\')
+              ) {
+                res.status(400).json({ error: { code: 'unsupported_storage' } });
+                return;
+              }
+              const stream = await deps.getLocalFileStream(req, file.filepath);
+              const chunks: Buffer[] = [];
+              let size = 0;
+              for await (const chunk of stream) {
+                const bytes = Buffer.isBuffer(chunk) ? chunk : Buffer.from(chunk);
+                size += bytes.length;
+                if (size > 10 * 1024 * 1024) {
+                  stream.destroy();
+                  res.status(413).json({ error: { code: 'file_too_large' } });
+                  return;
+                }
+                chunks.push(bytes);
+              }
+              buffer = Buffer.concat(chunks);
+            }
+            total += buffer.length;
+            if (buffer.length > 10 * 1024 * 1024 || total > 20 * 1024 * 1024) {
+              res.status(413).json({ error: { code: 'file_too_large' } });
+              return;
+            }
+            assets.push({
+              name: file.filename ?? file.file_id,
+              mime,
+              data: buffer.toString('base64'),
+            });
+          }
+          const text =
+            message.text ||
+            (message.content ?? [])
+              .map((part) => (typeof part.text === 'string' ? part.text : (part.text?.value ?? '')))
+              .join('\n');
+          body = { text, assets, conversation_id, message_id, operation_key };
+        }
+        const query = new URLSearchParams();
+        for (const key of ['conversation_id', 'message_id', 'version']) {
+          if (typeof req.query[key] === 'string') {
+            query.set(key, req.query[key]);
+          }
+        }
+        // Fixed loopback peer is intentional: this integration never accepts a user-supplied origin.
+        const response = await fetch(`http://127.0.0.1:8768/library${req.path}?${query}`, {
+          method: req.method,
+          headers: {
+            Authorization: `Bearer ${deps.token}`,
+            'X-Library-Owner': owner,
+            'Content-Type': 'application/json',
+          },
+          ...(post ? { body: JSON.stringify(body) } : {}),
+          signal: AbortSignal.timeout(30000),
+        });
+        res.setHeader('Cache-Control', 'no-store');
+        res.setHeader('Content-Type', response.headers.get('content-type') ?? 'application/json');
+        const disposition = response.headers.get('content-disposition');
+        if (disposition) {
+          res.setHeader('Content-Disposition', disposition);
+        }
+        res.status(response.status).send(Buffer.from(await response.arrayBuffer()));
+      } catch {
+        res.status(503).json({ error: { code: 'library_unavailable' } });
+      }
+    },
+  );
+  return router;
+}
