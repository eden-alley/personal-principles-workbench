+        className="size-9 flex-shrink-0 rounded-xl bg-presentation hover:bg-surface-tertiary"
+      >
+        <BookOpen className="icon-md" aria-hidden="true" />
+      </Button>
+      <LibraryDialog open={open} onOpenChange={setOpen} conversationId={conversationId} />
+    </>
+  );
+}
+
+export default function LibraryDialog({
+  open,
+  onOpenChange,
+  conversationId,
+  initialId,
+}: {
+  open: boolean;
+  onOpenChange: (open: boolean) => void;
+  conversationId?: string;
+  initialId?: number;
+}) {
+  const localize = useLocalize();
+  return (
+    <OGDialog open={open} onOpenChange={onOpenChange}>
+      <OGDialogContent className="flex max-h-[90dvh] w-11/12 max-w-4xl flex-col overflow-hidden">
+        <OGDialogHeader>
+          <OGDialogTitle>{localize('com_ui_library_title')}</OGDialogTitle>
+        </OGDialogHeader>
+        {open && (
+          <LibraryBody
+            key={`${conversationId ?? 'new'}-${initialId ?? ''}`}
+            conversationId={conversationId}
+            initialId={initialId}
+          />
+        )}
+      </OGDialogContent>
+    </OGDialog>
+  );
+}
+
+function LibraryBody({
+  conversationId,
+  initialId,
+}: {
+  conversationId?: string;
+  initialId?: number;
+}) {
+  const localize = useLocalize();
+  const kindLabel = useKindLabel();
+  const id = useId();
+  const list = useLibraryEntries();
+  const conversation = useLibraryConversation(conversationId);
+  const [filter, setFilter] = useState<LibraryKind | 'removed'>('principle');
+  const [selectedId, setSelectedId] = useState(initialId);
+  const [sourceEditor, setSourceEditor] = useState(false);
+  const [topic, setTopic] = useState('');
+  const [editor, setEditor] = useState<{
+    kind: 'principle' | 'experience';
+    entry?: LibraryEntry;
+  }>();
+  const initialSelected = useRef(false);
+  useEffect(() => {
+    const initialEntry = list.data?.entries.find((entry) => entry.id === initialId);
+    if (!initialSelected.current && initialEntry) {
+      setFilter(initialEntry.removed ? 'removed' : initialEntry.kind);
+      initialSelected.current = true;
+    }
+  }, [initialId, list.data]);
+  const update = useLibraryWrite('conversation', libraryService.updateConversation);
+  const exportData = useMutation({
+    mutationKey: [MutationKeys.libraryDownload, 'export'],
+    mutationFn: async () =>
+      downloadBlob(
+        new Blob([JSON.stringify(await libraryService.export(), null, 2)], {
+          type: 'application/json',
+        }),
+        'personal-library.json',
+      ),
+    retry: false,
+  });
+  const entries = list.data?.entries ?? [];
+  const visible = entries.filter((item) =>
+    filter === 'removed'
+      ? item.removed
+      : !item.removed &&
+        item.kind === filter &&
+        (filter !== 'source' || !topic || item.organization?.topics?.includes(topic)),
+  );
+  const topics = [
+    ...new Set(
+      entries
+        .filter((item) => item.kind === 'source' && !item.removed)
+        .flatMap((item) => item.organization?.topics ?? []),
+    ),
+  ].sort();
+  const state = conversation.data;
+  const change = (values: Partial<LibraryConversation>) => {
+    if (conversationId && !update.isLoading) {
+      update.mutate({ conversation_id: conversationId, ...values });
+    }
+  };
+  const onSaved = (entry: LibraryEntry) => {
+    setSourceEditor(false);
+    setTopic('');
+    setEditor(undefined);
+    setSelectedId(entry.id);
+    setFilter(entry.kind);
+  };
+
+  const renderDetail = () => {
+    if (sourceEditor) {
+      return <SourceEditor onSaved={onSaved} onCancel={() => setSourceEditor(false)} />;
+    }
+    if (editor) {
+      return (
+        <Editor
+          key={editor.entry?.id ?? editor.kind}
+          kind={editor.kind}
+          entry={editor.entry}
+          entries={entries}
+          onSaved={onSaved}
+          onCancel={() => setEditor(undefined)}
+        />
+      );
+    }
+    if (selectedId != null) {
+      return (
+        <Entry
+          key={selectedId}
+          entryId={selectedId}
+          entries={entries}
+          conversation={state}
+          conversationBusy={update.isLoading}
+          onConversationChange={change}
+          onEdit={(entry) => setEditor({ kind: 'principle', entry })}
+          onOpen={(id) => {
+            setSelectedId(id);
+            setFilter('source');
+            setTopic('');
+          }}
+        />
+      );
+    }
+    return (
+      <p className="py-3 text-sm text-text-secondary">{localize('com_ui_library_choose_entry')}</p>
+    );
+  };
+
+  return (
+    <div className="flex min-h-0 flex-col gap-4 overflow-y-auto">
+      <p className="text-sm text-text-secondary">{localize('com_ui_library_hint')}</p>
+      <div className="flex flex-wrap gap-2">
+        <Button
+          size="sm"
+          onClick={() => {
+            setSourceEditor(true);
+            setEditor(undefined);
+            setFilter('source');
+          }}
+        >
+          {localize('com_ui_library_add_source')}
+        </Button>
+        <Button
+          size="sm"
+          variant="outline"
+          onClick={() => {
+            setSourceEditor(false);
+            setEditor({ kind: 'principle' });
+          }}
+        >
+          {localize('com_ui_library_add_principle')}
+        </Button>
+        <Button
+          size="sm"
+          variant="outline"
+          onClick={() => {
+            setSourceEditor(false);
+            setEditor({ kind: 'experience' });
+          }}
+        >
+          {localize('com_ui_library_add_experience')}
+        </Button>
+        <Button
+          size="sm"
+          variant="outline"
+          disabled={exportData.isLoading}
+          onClick={() => exportData.mutate()}
+        >
+          {localize('com_ui_library_export')}
+        </Button>
+      </div>
+      {exportData.isError && <Failure />}
+      {conversation.isFetching && !state && <Loading />}
+      {conversation.isError && <Failure retry={() => void conversation.refetch()} />}
+      {state && (
+        <details className="space-y-3">
+          <summary className="cursor-pointer text-sm font-medium">
+            {localize('com_ui_library_conversation')} ·{' '}
+            {localize('com_ui_library_selected_count', { count: state.selected_ids.length })}
+          </summary>
+          <p className="mt-3 text-sm text-text-secondary">
+            {localize('com_ui_library_selection_hint')}
+          </p>
+          <label htmlFor={`${id}-proposals`} className="flex items-start gap-2 text-sm">
+            <input
+              id={`${id}-proposals`}
+              type="checkbox"
+              checked={state.proposals_enabled}
+              disabled={update.isLoading}
+              onChange={(event) => change({ proposals_enabled: event.target.checked })}
+              className="mt-1"
+            />
+            <span>{localize('com_ui_library_proposals_enabled')}</span>
+          </label>
+          {(['selected_ids', 'excluded_ids'] as const).map(
+            (field) =>
+              state[field].length > 0 && (
+                <section key={field}>
+                  <h3 className="mb-2 text-sm font-medium">
+                    {localize(
+                      field === 'selected_ids'
+                        ? 'com_ui_library_selected'
+                        : 'com_ui_library_excluded',
+                    )}
+                  </h3>
+                  <ul className="space-y-2">
+                    {state[field].map((entryId) => (
+                      <li key={entryId} className="flex items-start justify-between gap-2 text-sm">
+                        <span className="break-words">
+                          {entries.find((entry) => entry.id === entryId)?.title || String(entryId)}
+                        </span>
+                        <Button
+                          size="sm"
+                          variant="outline"
+                          disabled={update.isLoading}
+                          onClick={() =>
+                            change({ [field]: state[field].filter((value) => value !== entryId) })
+                          }
+                        >
+                          {localize(
+                            field === 'selected_ids'
+                              ? 'com_ui_library_unselect'
+                              : 'com_ui_library_include_again',
+                          )}
+                        </Button>
+                      </li>
+                    ))}
+                  </ul>
+                </section>
+              ),
+          )}
+        </details>
+      )}
+      {!conversationId && (
+        <p className="text-sm text-text-secondary">
+          {localize('com_ui_library_new_conversation_hint')}
+        </p>
+      )}
+      {update.isError && <Failure error={update.error} />}
+      {list.isLoading && <Loading />}
+      {list.isError && (
+        <Failure
+          error={list.error instanceof Error ? list.error : undefined}
+          retry={() => void list.refetch()}
+        />
+      )}
+      {!list.isLoading && !list.isError && (
+        <>
+          <nav
+            aria-label={localize('com_ui_library_categories')}
+            className="flex flex-wrap gap-2 border-b border-border-light pb-3"
+          >
+            {(['principle', 'source', 'experience', 'removed'] as const).map((kind) => (
+              <Button
+                key={kind}
+                size="sm"
+                variant={filter === kind ? 'default' : 'outline'}
+                aria-pressed={filter === kind}
+                onClick={() => {
+                  setFilter(kind);
+                  setTopic('');
+                  setSourceEditor(false);
+                  setEditor(undefined);
+                  setSelectedId(undefined);
+                }}
+              >
+                {kind === 'removed' ? localize('com_ui_library_trash') : kindLabel(kind)}
+              </Button>
+            ))}
+          </nav>
+          {filter === 'source' && !sourceEditor && topics.length > 0 && (
+            <div className="flex items-center gap-3 text-sm">
+              <label htmlFor={`${id}-topic`}>{localize('com_ui_library_topic_filter')}</label>
+              <select
+                id={`${id}-topic`}
+                value={topic}
+                onChange={(event) => {
+                  setTopic(event.target.value);
+                  setSelectedId(undefined);
+                }}
+                className="min-w-0 rounded-md border border-border-light bg-surface-primary px-2 py-1"
+              >
+                <option value="">{localize('com_ui_library_all_topics')}</option>
+                {topics.map((value) => (
+                  <option key={value} value={value}>
+                    {value}
+                  </option>
+                ))}
+              </select>
+            </div>
+          )}
+          <div className="grid min-h-0 gap-5 md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
+            <div className="max-h-44 overflow-y-auto md:max-h-[50dvh]">
+              {visible.length === 0 ? (
+                <p className="py-3 text-sm text-text-secondary">
+                  {localize(
+                    filter === 'removed' ? 'com_ui_library_trash_empty' : 'com_ui_library_empty',
+                  )}
+                </p>
+              ) : (
+                <ul className="space-y-1">
+                  {visible.map((entry) => (
+                    <li key={entry.id}>
+                      <button
+                        type="button"
+                        onClick={() => {
+                          setSelectedId(entry.id);
+                          setSourceEditor(false);
+                          setEditor(undefined);
+                        }}
+                        aria-pressed={selectedId === entry.id}
+                        className={`w-full rounded-lg px-3 py-3 text-left text-sm hover:bg-surface-tertiary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-border-heavy ${selectedId === entry.id ? 'bg-surface-secondary' : ''}`}
+                      >
+                        <span className="block break-words font-medium">
+                          {entry.organization?.title || entry.title || String(entry.id)}
+                        </span>
+                        <span className="mt-1 block text-xs text-text-secondary">
+                          {kindLabel(entry.kind)}
+                          {entry.kind === 'source' && entry.organization?.topics?.length
+                            ? ` · ${entry.organization.topics.join(' / ')}`
+                            : ''}
+                        </span>
+                      </button>
+                    </li>
+                  ))}
+                </ul>
+              )}
+            </div>
+            <div className="min-w-0 md:max-h-[50dvh] md:overflow-y-auto md:pr-2">
+              {renderDetail()}
+            </div>
+          </div>
+        </>
+      )}
+    </div>
+  );
+}
diff --git a/client/src/components/Library/Editor.tsx b/client/src/components/Library/Editor.tsx
new file mode 100644
index 0000000..8d1ebee
--- /dev/null
+++ b/client/src/components/Library/Editor.tsx
@@ -0,0 +1,169 @@
+import { useId, useState } from 'react';
+import { libraryService } from 'librechat-data-provider';
+import { Button, Input, Label, Textarea } from '@librechat/client';
+import type { LibraryEntry, LibraryKind, LibraryPrincipleInput } from 'librechat-data-provider';
+import { useOperationKey, useLibraryWrite } from './hooks';
+import { useLocalize } from '~/hooks';
+import { Failure } from './Feedback';
+
+export default function Editor({
+  kind,
+  entry,
+  entries,
+  onSaved,
+  onCancel,
+}: {
+  kind: Exclude<LibraryKind, 'source'>;
+  entry?: LibraryEntry;
+  entries: LibraryEntry[];
+  onSaved: (entry: LibraryEntry) => void;
+  onCancel: () => void;
+}) {
+  const localize = useLocalize();
+  const id = useId();
+  const operationKey = useOperationKey();
+  const [text, setText] = useState(entry?.text ?? '');
+  const [reason, setReason] = useState('');
+  const [sourceIds, setSourceIds] = useState(entry?.source_ids ?? []);
+  const [experienceIds, setExperienceIds] = useState(entry?.experience_ids ?? []);
+  const save = useLibraryWrite(
+    'save',
+    (input: LibraryPrincipleInput) =>
+      kind === 'principle'
+        ? libraryService.principle(input)
+        : libraryService.experience({
+            facts: input.statement,
+            confirmed: true,
+            operation_key: input.operation_key,
+          }),
+    onSaved,
+  );
+  const canSave = text.trim().length > 0 && (!entry || reason.trim().length > 0);
+  const createLabel =
+    kind === 'principle' ? 'com_ui_library_add_principle' : 'com_ui_library_add_experience';
+  const associations = (
+    associationKind: 'source' | 'experience',
+    ids: number[],
+    setIds: (ids: number[]) => void,
+  ) => {
+    const choices = entries.filter((item) => item.kind === associationKind && !item.removed);
+    return (
+      <fieldset className="space-y-2">
+        <legend className="text-sm font-medium">
+          {localize(
+            associationKind === 'source' ? 'com_ui_library_sources' : 'com_ui_library_experiences',
+          )}
+        </legend>
+        {choices.length === 0 && (
+          <p className="text-sm text-text-secondary">
+            {localize('com_ui_library_no_associations')}
+          </p>
+        )}
+        <div className="max-h-32 space-y-2 overflow-y-auto">
+          {choices.map((item) => (
+            <label key={item.id} className="flex items-start gap-2 text-sm">
+              <input
+                type="checkbox"
+                checked={ids.includes(item.id)}
+                disabled={save.isLoading}
+                onChange={(event) =>
+                  setIds(
+                    event.target.checked
+                      ? [...ids, item.id]
+                      : ids.filter((value) => value !== item.id),
+                  )
+                }
+                className="mt-1"
+              />
+              <span className="break-words">{item.title || String(item.id)}</span>
+            </label>
+          ))}
+        </div>
+        {ids
+          .filter((value) => !choices.some((choice) => choice.id === value))
+          .map((value) => (
+            <label key={value} className="flex gap-2 text-sm text-text-secondary">
+              <input
+                type="checkbox"
+                checked
+                disabled={save.isLoading}
+                onChange={() => setIds(ids.filter((item) => item !== value))}
+              />
+              {localize('com_ui_library_unavailable_association', { id: String(value) })}
+            </label>
+          ))}
+      </fieldset>
+    );
+  };
+
+  return (
+    <form
+      className="space-y-4"
+      onSubmit={(event) => {
+        event.preventDefault();
+        if (!canSave || save.isLoading) {
+          return;
+        }
+        save.mutate({
+          statement: text.trim(),
+          entry_id: entry?.id,
+          expected_revision: entry?.revision,
+          reason: reason.trim(),
+          source_ids: sourceIds,
+          experience_ids: experienceIds,
+          confirmed: true,
+          operation_key: operationKey,
+        });
+      }}
+    >
+      <h3 className="font-semibold">
+        {localize(entry ? 'com_ui_library_edit_principle' : createLabel)}
+      </h3>
+      <p className="text-sm text-text-secondary">
+        {localize(
+          kind === 'principle' ? 'com_ui_library_principle_hint' : 'com_ui_library_experience_hint',
+        )}
+      </p>
+      <div className="space-y-2">
+        <Label htmlFor={`${id}-text`}>
+          {localize(kind === 'principle' ? 'com_ui_library_statement' : 'com_ui_library_facts')}
+        </Label>
+        <Textarea
+          id={`${id}-text`}
+          value={text}
+          onChange={(event) => setText(event.target.value)}
+          rows={5}
+          required
+          disabled={save.isLoading}
+        />
+      </div>
+      {kind === 'principle' && (
+        <>
+          <div className="space-y-2">
+            <Label htmlFor={`${id}-reason`}>
+              {localize(entry ? 'com_ui_library_revision_reason' : 'com_ui_library_reason')}
+            </Label>
+            <Input
+              id={`${id}-reason`}
+              value={reason}
+              onChange={(event) => setReason(event.target.value)}
+              required={!!entry}
+              disabled={save.isLoading}
+            />
+          </div>
+          {associations('source', sourceIds, setSourceIds)}
+          {associations('experience', experienceIds, setExperienceIds)}
+        </>
+      )}
+      {save.isError && <Failure error={save.error} />}
+      <div className="flex flex-wrap justify-end gap-2">
+        <Button type="button" variant="outline" onClick={onCancel} disabled={save.isLoading}>
+          {localize('com_ui_cancel')}
+        </Button>
+        <Button type="submit" disabled={!canSave || save.isLoading}>
+          {localize(save.isLoading ? 'com_ui_library_saving' : 'com_ui_library_confirm_save')}
+        </Button>
+      </div>
+    </form>
+  );
+}
diff --git a/client/src/components/Library/Entry.tsx b/client/src/components/Library/Entry.tsx
new file mode 100644
index 0000000..757ce67
--- /dev/null
+++ b/client/src/components/Library/Entry.tsx
@@ -0,0 +1,397 @@
+import { useId, useState } from 'react';
+import { useMutation } from '@tanstack/react-query';
+import { Button, Input, Label } from '@librechat/client';
+import { libraryService, MutationKeys } from 'librechat-data-provider';
+import type { LibraryConversation, LibraryEntry, LibraryKind } from 'librechat-data-provider';
+import { downloadBlob, useLibraryEntry, useLibraryWrite } from './hooks';
+import { Failure, Loading } from './Feedback';
+import { useLocalize } from '~/hooks';
+import Organization from './Organization';
+
+export function useKindLabel() {
+  const localize = useLocalize();
+  const labels = {
+    source: 'com_ui_library_source',
+    principle: 'com_ui_library_principle',
+    experience: 'com_ui_library_experience',
+  } as const;
+  return (kind: LibraryKind) => localize(labels[kind]);
+}
+
+function Status({ state }: { state?: string }) {
+  const localize = useLocalize();
+  if (['pending', 'queued', 'processing', 'running'].includes(state ?? '')) {
+    return <span>{localize('com_ui_library_pending')}</span>;
+  }
+  if (['ready', 'done', 'completed', 'indexed', 'success', 'parsed'].includes(state ?? '')) {
+    return <span>{localize('com_ui_library_ready')}</span>;
+  }
+  if (['failed', 'error'].includes(state ?? '')) {
+    return <span>{localize('com_ui_library_failed')}</span>;
+  }
+  return <span>{localize('com_ui_library_unavailable')}</span>;
+}
+
+function PrincipleStatus({ status }: { status: string }) {
+  const localize = useLocalize();
+  if (status === 'adopted') {
+    return <p className="text-text-secondary">{localize('com_ui_library_adopted')}</p>;
+  }
+  if (status === 'trial') {
+    return <p className="text-text-secondary">{localize('com_ui_library_trial')}</p>;
+  }
+  if (status === 'candidate') {
+    return <p className="text-text-secondary">{localize('com_ui_library_candidate')}</p>;
+  }
+  if (status === 'retired') {
+    return <p className="text-text-secondary">{localize('com_ui_library_retired')}</p>;
+  }
+  return null;
+}
+
+export default function Entry({
+  entryId,
+  entries,
+  conversation,
+  conversationBusy,
+  onConversationChange,
+  onEdit,
+  onOpen,
+}: {
+  entryId: number;
+  entries: LibraryEntry[];
+  conversation?: LibraryConversation;
+  conversationBusy: boolean;
+  onConversationChange: (change: Partial<LibraryConversation>) => void;
+  onEdit: (entry: LibraryEntry) => void;
+  onOpen?: (id: number) => void;
+}) {
+  const localize = useLocalize();
+  const kindLabel = useKindLabel();
+  const id = useId();
+  const entryQuery = useLibraryEntry(entryId);
+  const [removing, setRemoving] = useState(false);
+  const [confirmation, setConfirmation] = useState('');
+  const remove = useLibraryWrite(
+    'remove',
+    (input: { entry: LibraryEntry; removed: boolean }) =>
+      libraryService.remove(input.entry.id, {
+        removed: input.removed,
+        expected_revision: input.entry.revision,
+        confirmed: true,
+      }),
+    () => {
+      setRemoving(false);
+      setConfirmation('');
+    },
+  );
+  const retry = useLibraryWrite('retry', libraryService.retry);
+  const asset = useMutation({
+    mutationKey: [MutationKeys.libraryDownload, 'asset'],
+    mutationFn: async (file: { id: number; name: string }) =>
+      downloadBlob(await libraryService.asset(file.id), file.name),
+    retry: false,
+  });
+  if (entryQuery.isLoading) {
+    return <Loading />;
+  }
+  if (entryQuery.isError || !entryQuery.data) {
+    return (
+      <Failure
+        error={entryQuery.error instanceof Error ? entryQuery.error : undefined}
+        retry={() => void entryQuery.refetch()}
+      />
+    );
+  }
+  const entry = entryQuery.data;
+  const selected = conversation?.selected_ids.includes(entry.id) ?? false;
+  const excluded = conversation?.excluded_ids.includes(entry.id) ?? false;
+  const selectedIds = conversation?.selected_ids ?? [];
+  const excludedIds = conversation?.excluded_ids ?? [];
+  const linked = [...entry.source_ids, ...entry.experience_ids];
+  const exactTitle = entry.title || String(entry.id);
+  return (
+    <article className="min-w-0 space-y-4">
+      <header className="space-y-1">
+        <p className="text-sm text-text-secondary">
+          {kindLabel(entry.kind)}
+          {entry.version != null && (
+            <> · {localize('com_ui_library_version', { version: entry.version })}</>
+          )}
+        </p>
+        <h3 className="break-words font-semibold">{exactTitle}</h3>
+      </header>
+      {entry.kind === 'source' && (
+        <p className="text-sm text-text-secondary">{localize('com_ui_library_source_hint')}</p>
+      )}
+      {entry.kind === 'source' && <Organization entry={entry} entries={entries} onOpen={onOpen} />}
+      <section className="space-y-2">
+        <h4 className="text-sm font-medium">
+          {localize(entry.kind === 'source' ? 'com_ui_library_original' : 'com_ui_library_content')}
+        </h4>
